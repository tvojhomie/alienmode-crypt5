{
  "openapi": "3.1.0",
  "info": { "title": "AlienMode Provider Links", "version": "1.0.0" },
  "paths": {
    "/v1/links": {
      "post": {
        "summary": "Encrypt a subscription URL locally; does not fetch it",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "additionalProperties": false, "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 16384, "description": "HTTPS without userinfo; also limited to 16384 UTF-8 bytes" },
              "title": { "type": "string", "maxLength": 200 }
            }
          } } }
        },
        "responses": {
          "200": { "description": "Encrypted link", "content": { "application/json": { "schema": {
            "type": "object", "required": ["link"], "properties": { "link": { "type": "string", "pattern": "^alienmode://crypt5/" } }
          } } } },
          "400": { "description": "Invalid input" },
          "401": { "description": "Missing or invalid API token" },
          "404": { "description": "Unknown method or path" },
          "413": { "description": "Body exceeds 24576 bytes or uses content encoding" },
          "415": { "description": "application/json required" },
          "429": { "description": "Process rate limit exceeded" }
        }
      }
    }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } } }
}
